{
  "name": "hs-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Archer H&S Management System — multi-tenant web app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "test": "node --test test/reports.test.mjs && npm run check",
    "check:consistency": "node scripts/check-app-report-consistency.mjs",
    "check:masthead": "node scripts/check-report-masthead-fit.mjs",
    "check": "npm run check:consistency && npm run check:masthead && npm run check:overflow",
    "check:overflow": "node scripts/check-report-page-overflow.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "puppeteer-core": "^25.8.0"
  },
  "license": "UNLICENSED",
  "optionalDependencies": {
    "pg-mem": "^3.0.14"
  }
}
